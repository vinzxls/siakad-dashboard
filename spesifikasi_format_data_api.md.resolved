    { "fakultas": "Hukum", "pendaftar": 880, "diterima": 440 },
    { "fakultas": "Teknik", "pendaftar": 1300, "diterima": 660 },
    { "fakultas": "Ekonomi", "pendaftar": 950, "diterima": 470 }
